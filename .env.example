LEO_USERNAME=
# Single quotes: an unquoted # starts a comment and cuts the password short
LEO_PASSWORD=''
# Base32 secret from Bolt > Security settings > authenticator app (see README). Leave empty to type the SMS code by hand.
LEO_TOTP_SECRET=
# Optional. Without it, the AI tests run Claude through your Claude Code login.
ANTHROPIC_API_KEY=
# Optional. Pins the city for the researched reel; leave it out for a random city each run.
LEO_STORY_AREA=
# Host of the S3 bucket Leo stores produced files in (see README)
LEO_S3_HOST=
